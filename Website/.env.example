# ==============================================================================
# Weqaya G6PD (وقاية أنيميا الفول) — Environment Configuration Template
# ==============================================================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development
PORT=3000

# Base URL of the Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database Configuration (PostgreSQL 16)
# Production Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=postgresql://weqaya_admin:weqaya_secret_pass@localhost:5432/weqaya_g6pd
# Optional SQLite fallback for local zero-setup dev when Postgres is unavailable:
# DATABASE_URL=file:./dev.db

# Redis Configuration (Upstash or self-hosted Redis 7+)
REDIS_URL=redis://localhost:6379

# JWT Authentication Secret (HS256) — generate with: openssl rand -base64 32
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_for_security_123

# Cloudflare Turnstile / Bot Protection (Optional in local dev, required in production)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# S3 / Cloudflare R2 Object Storage for Images (Optional in local dev fallback)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=weqaya-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_DOMAIN=

# Support / Contact Mailto
SUPPORT_EMAIL=contact@weqaya.org

# Rate Limiting Overrides (Sliding window counts)
RATE_LIMIT_SEARCH_PER_MIN=120
RATE_LIMIT_VOTES_PER_MIN=60
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_ADD_ITEM_PER_HOUR=5
RATE_LIMIT_ACCOUNT_CREATE_SOFT=3
